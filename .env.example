# ==============================================================================
# Dossia — Local Environment Variables (Template)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.
# ==============================================================================

# French Medical Voice-to-Form Scribe (Radox AI OpenAI-compatible Gateway)
# Provider: https://radoxai.com/v1
DOSSIA_AI_API_KEY=
DOSSIA_AI_BASE_URL=https://radoxai.com/v1
DOSSIA_AI_MODEL=gpt-4o-mini

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dossia_db
DB_USER=dossia_user
DB_PASSWORD=dossia_dev_password_2026

# MinIO Medical Document Vault
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=dossia_minio_admin
MINIO_SECRET_KEY=dossia_minio_dev_secret_2026
MINIO_BUCKET=dossia-medical-vault
