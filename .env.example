# ==============================================================================
# Dossia — Local Environment Variables (Template)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control (CNDP Loi 09-08).
# ==============================================================================

# HashiCorp Vault Community Edition (SEC-01 Centralized Secrets Management)
DOSSIA_VAULT_ENABLED=true
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dossia_vault_dev_root_token_2026
VAULT_SECRET_PATH=secret/data/dossia

# Cryptographic Signing (HMAC-SHA256, minimum 32 characters / 256 bits) (SEC-04)
JWT_SECRET=your_minimum_32_characters_random_jwt_secret_key_here

# French Medical Voice-to-Form Scribe (Radox AI OpenAI-compatible Gateway)
# Provider: https://radoxai.com/v1
DOSSIA_AI_API_KEY=
DOSSIA_AI_BASE_URL=https://radoxai.com/v1
DOSSIA_AI_MODEL=gpt-4o-mini

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dossia_db
DB_USER=dossia_user
DB_PASSWORD=dossia_dev_password_2026

# MinIO Medical Document Vault
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=dossia_minio_admin
MINIO_SECRET_KEY=dossia_minio_dev_secret_2026
MINIO_BUCKET=dossia-medical-vault
