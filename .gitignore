# ==============================================================================
# Dossia Monorepo — Git Ignore
# ==============================================================================

# Environment variables & secrets (CNDP Loi 09-08 Zero-Leakage Mandate)
.env
.env.*
!.env.example
*.local

# Dependencies & Build Outputs
node_modules/
frontend/dist/
backend/target/
dist/

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
